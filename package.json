    "test:e2e:hosted:hide-content": "node -e \"const result=require('node:child_process').spawnSync(process.execPath,['node_modules/@playwright/test/cli.js','test','--config','playwright.hosted.config.ts'],{stdio:'inherit',env:{...process.env,CAMPUS_E2E_HIDE_CONTENT:'1'}});process.exit(result.status ?? 1)\"",
    "test:e2e:hosted:staff-totp": "node -e \"const result=require('node:child_process').spawnSync(process.execPath,['node_modules/@playwright/test/cli.js','test','--config','playwright.hosted.config.ts'],{stdio:'inherit',env:{...process.env,CAMPUS_E2E_STAFF_TOTP:'1'}});process.exit(result.status ?? 1)\"",
