    "test:e2e:hosted:postgrest": "node -e \"const result=require('node:child_process').spawnSync(process.execPath,['node_modules/@playwright/test/cli.js','test','--config','playwright.hosted.config.ts'],{stdio:'inherit',env:{...process.env,CAMPUS_E2E_POSTGREST:'1'}});process.exit(result.status ?? 1)\"",
