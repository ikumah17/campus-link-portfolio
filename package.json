{
  "name": "campus-link",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "test:e2e:hosted": "playwright test --config playwright.hosted.config.ts",
    "test:e2e:hosted:nt21": "node -e \"const result=require('node:child_process').spawnSync(process.execPath,['node_modules/@playwright/test/cli.js','test','--config','playwright.hosted.config.ts'],{stdio:'inherit',env:{...process.env,CAMPUS_E2E_NT21:'1'}});process.exit(result.status ?? 1)\"",
    "test:e2e:hosted:nt19": "node -e \"const result=require('node:child_process').spawnSync(process.execPath,['node_modules/@playwright/test/cli.js','test','--config','playwright.hosted.config.ts'],{stdio:'inherit',env:{...process.env,CAMPUS_E2E_NT19:'1'}});process.exit(result.status ?? 1)\"",
