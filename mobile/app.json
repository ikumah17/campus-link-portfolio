{
  "expo": {
    "name": "Campus Link",
    "slug": "campus-link",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "プロフィールの写真を選ぶために、写真ライブラリを使います。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-status-bar"
    ]
  }
}
