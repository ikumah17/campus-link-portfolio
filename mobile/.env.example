# Copy to mobile/.env.local (git-ignored) and fill in. Public values only: never a service-role key.
# The same values as the web's NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (the development Supabase project).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional. Empty: the web's `next dev` server on the development machine, at the LAN address Expo Go used (http://<LAN address>:3000).
# Never a deployment behind an authentication wall (such as a protected preview): it refuses the app's requests.
EXPO_PUBLIC_API_BASE_URL=
